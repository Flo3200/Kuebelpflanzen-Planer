# Kopieren nach .env und Werte anpassen.
KP_ENV=development
KP_BASE_URL=http://localhost:8000
# Zufällige lange Zeichenkette (Sitzungen, Signaturen)
KP_SECRET_KEY=change-me
# Fernet-Schlüssel für gespeicherte Geheimnisse (API-Schlüssel, TOTP):
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
KP_ENCRYPTION_KEY=
# Laufzeitrolle (kein Superuser, kein BYPASSRLS)
KP_DATABASE_URL=postgresql+psycopg://kp_app:app-pw@localhost:5433/kuebelplaner
# Besitzerrolle für Migrationen
KP_DATABASE_OWNER_URL=postgresql+psycopg://kp_owner:owner-pw@localhost:5433/kuebelplaner
KP_TEST_DATABASE_URL=postgresql+psycopg://kp_app:app-pw@localhost:5433/kuebelplaner_test
KP_TEST_DATABASE_OWNER_URL=postgresql+psycopg://kp_owner:owner-pw@localhost:5433/kuebelplaner_test
KP_FILES_DIR=./data/files
# local | s3 (später)
KP_STORAGE_BACKEND=local
KP_COOKIE_SECURE=false
# offline | osrm | ors | google
KP_ROUTING_PROVIDER=offline
KP_OSRM_URL=https://router.project-osrm.org
KP_ORS_API_KEY=
KP_GOOGLE_MAPS_API_KEY=
# Plattform-KI-Schlüssel (optional; Betriebe können eigene Schlüssel hinterlegen)
KP_ANTHROPIC_API_KEY=
KP_OPENAI_API_KEY=
# Online-Zahlung über Stripe Connect (optional): Plattform-Schlüssel und Webhook-Geheimnis
KP_STRIPE_SECRET_KEY=
KP_STRIPE_WEBHOOK_SECRET=
# Erstes Admin-Konto, wird beim ersten Start angelegt
KP_INITIAL_ADMIN_EMAIL=admin@example.com
KP_INITIAL_ADMIN_PASSWORD=change-me
# Nur für docker compose: Passwörter der Datenbankrollen
KP_SUPER_PASSWORD=change-me-super
KP_OWNER_PASSWORD=change-me-owner
KP_APP_PASSWORD=change-me-app
